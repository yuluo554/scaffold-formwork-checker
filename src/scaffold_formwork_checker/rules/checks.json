{
  "meta": {
    "table_id": "sfc-rules-checks",
    "version": "M3",
    "purpose": "构造限值核查规则表（rules 运行器消费）。limit_ref 指向 thresholds.json 条目（不写死数值；条目 status=待核对 即拦截跳过）；only_if 为类目门控关键词（全部命中 scheme.project_type 才生效，对全部 check_type 一致生效）；规则自身 status!=已核对 同样跳过并记待人工确认。",
    "level_semantics": "三级判定：提示=方向偏保守/信息性；不合格=构造超限/必备措施缺失/两张皮（危险方向）；严重=法定程序义务缺失。",
    "verdict_semantics": "pass=通过；violation=违规（进违规清单，任何 level）；triggered=分级触发（信息性结论，grading 判定器产出）。",
    "gate_text_source": "scheme_card.project_type（工程类型描述文本，方案标题行）"
  },
  "rules": [
    {
      "rule_id": "R-step-limit",
      "name": "步距不超过常用构造限值",
      "category": "coupler_steel_pipe_scaffold",
      "only_if": ["扣件", "落地式"],
      "check_type": "threshold",
      "param": "step",
      "op": "<=",
      "limit_ref": "T-JGJ130-step-max",
      "level": "不合格",
      "clause_refs": ["JGJ130-6.1.1"],
      "advice": "将步距调整至表6.1.1-1 常用步距档（≤1.8m）内，并同步修改验算书取值",
      "status": "已核对"
    },
    {
      "rule_id": "R-step-limit-20",
      "name": "步距不超过规范表格域最大档",
      "category": "coupler_steel_pipe_scaffold",
      "only_if": ["扣件", "落地式"],
      "check_type": "threshold",
      "param": "step",
      "op": "<=",
      "limit_ref": "T-JGJ130-step-max-loose",
      "level": "不合格",
      "clause_refs": ["JGJ130-6.1.1", "JGJ130-A.0.1"],
      "advice": "步距超出本规范全部表格档位（最大 2.0m 仅满堂支撑架侧采用），必须返工调整",
      "status": "已核对"
    },
    {
      "rule_id": "R-walltie-vspacing",
      "name": "连墙件竖向间距不超过表6.4.2 限值",
      "category": "coupler_steel_pipe_scaffold",
      "only_if": ["扣件"],
      "check_type": "threshold",
      "param": "wall_tie_v",
      "op": "<=",
      "limit_ref": "T-JGJ130-walltie-spacing",
      "limit_key": "竖向",
      "level": "不合格",
      "clause_refs": ["JGJ130-6.4.2"],
      "advice": "按表6.4.2 收紧连墙件竖向间距（双排 H≤50m ≤3h；H>50m ≤2h；单排 H≤24m ≤3h）",
      "status": "已核对"
    },
    {
      "rule_id": "R-walltie-hspacing",
      "name": "连墙件水平间距不超过表6.4.2 限值",
      "category": "coupler_steel_pipe_scaffold",
      "only_if": ["扣件"],
      "check_type": "threshold",
      "param": "wall_tie_h",
      "op": "<=",
      "limit_ref": "T-JGJ130-walltie-spacing",
      "limit_key": "水平",
      "level": "不合格",
      "clause_refs": ["JGJ130-6.4.2"],
      "advice": "按表6.4.2 收紧连墙件水平间距（各档均 ≤3la）",
      "status": "已核对"
    },
    {
      "rule_id": "R-walltie-area",
      "name": "连墙件每根覆盖面积不超过表6.4.2 限值",
      "category": "coupler_steel_pipe_scaffold",
      "only_if": ["扣件"],
      "check_type": "threshold",
      "param": "wall_tie_area",
      "computed": "wall_tie_v * wall_tie_h",
      "op": "<=",
      "limit_ref": "T-JGJ130-walltie-spacing",
      "limit_key": "每根覆盖面积_m2",
      "level": "不合格",
      "clause_refs": ["JGJ130-6.4.2"],
      "advice": "加大连墙件布点密度，使每根连墙件覆盖面积不超过表6.4.2 限值",
      "status": "已核对"
    },
    {
      "rule_id": "R-brace-presence",
      "name": "剪刀撑设置措施必须在方案中载明",
      "category": "coupler_steel_pipe_scaffold",
      "only_if": ["扣件"],
      "check_type": "presence",
      "param": "scissor_brace",
      "level": "不合格",
      "clause_refs": ["JGJ130-6.6.2"],
      "advice": "补全剪刀撑布置章节（每道宽度≥4跨且≥6m、倾角45°~60°、24m及以上双排外侧全立面连续设置）",
      "status": "已核对"
    },
    {
      "rule_id": "R-formwork-step-limit",
      "name": "模板支架立柱步距不超过1.8m",
      "category": "formwork_support",
      "only_if": ["模板"],
      "check_type": "threshold",
      "param": "step",
      "op": "<=",
      "limit_ref": "T-JGJ162-column-step",
      "level": "不合格",
      "clause_refs": ["JGJ162-5.2.5"],
      "advice": "JGJ162-5.2.5：扣件式钢管立柱最大步距不得大于1.8m",
      "status": "已核对"
    },
    {
      "rule_id": "R-consistency-step",
      "name": "验算书步距取值与方案正文一致",
      "check_type": "consistency",
      "param": "step",
      "level": "不合格",
      "clause_refs": ["37号令-第十六条"],
      "advice": "统一方案正文与验算书取值并重新报审（严禁擅自修改专项施工方案）",
      "status": "已核对"
    },
    {
      "rule_id": "R-consistency-long-spacing",
      "name": "验算书立杆纵距取值与方案正文一致",
      "check_type": "consistency",
      "param": "long_spacing",
      "level": "不合格",
      "clause_refs": ["37号令-第十六条"],
      "advice": "统一方案正文与验算书取值并重新报审（严禁擅自修改专项施工方案）",
      "status": "已核对"
    },
    {
      "rule_id": "R-consistency-cross-spacing",
      "name": "验算书立杆横距取值与方案正文一致",
      "check_type": "consistency",
      "param": "cross_spacing",
      "level": "不合格",
      "clause_refs": ["37号令-第十六条"],
      "advice": "统一方案正文与验算书取值并重新报审（严禁擅自修改专项施工方案）",
      "status": "已核对"
    },
    {
      "rule_id": "R-grading-expert-review",
      "name": "超过一定规模的危大工程须载明专家论证安排",
      "check_type": "grading",
      "param": "expert_review",
      "require_level": "chaoguimo",
      "evidence_param": "expert_review",
      "evidence_label": "专家论证安排",
      "level": "严重",
      "clause_refs": ["37号令-第十二条"],
      "advice": "超过一定规模的危大工程，施工单位应当组织专家论证会（专家≥5名）对专项施工方案论证，方案应载明论证安排",
      "status": "已核对"
    },
    {
      "rule_id": "R-grading-special-plan",
      "name": "危大工程须载明专项施工方案编制安排",
      "check_type": "grading",
      "param": "special_plan",
      "require_level": "weida",
      "evidence_param": "special_plan",
      "evidence_label": "专项施工方案",
      "level": "不合格",
      "clause_refs": ["37号令-第十一条"],
      "advice": "危大工程应编制专项施工方案，经施工单位技术负责人审核签字盖章、总监理工程师审查签字盖章后方可实施",
      "status": "已核对"
    }
  ]
}
