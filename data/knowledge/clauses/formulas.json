      "status": "已核对",
      "source": {"file": "JGJ162-2008_pmgd_imgs/1-240P1094I2648.jpg", "fetched": "2026-10-06"}
    },
    {
      "formula_id": "F-J162-column-w",
      "expr": "Nw / (φ*A) + Mw / W <= f",
      "params": {},
      "applies_to": "M-6 模板支架立杆稳定·组合风（室外露天支模）",
      "clause_refs": ["JGJ162-5.2.5"],
