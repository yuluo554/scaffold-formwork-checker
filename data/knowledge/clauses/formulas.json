    },
    {
      "formula_id": "F-J162-column",
      "expr": "N / (φ*A) <= f",
      "params": {
        "N": {"meaning": "立柱轴心压力设计值（表4.3.2 组合①G1k+G2k+G3k+Q1k 各项乘分项系数）", "unit": "N", "source": "T-JGJ162-load-combo"},
        "φ": {"meaning": "轴心受压稳定系数（λ 查附录D表D=GB50017 b类，数值同 JGJ130 表A.0.6）", "unit": "-", "source": "T-JGJ130-phi-table"},
        "A": {"meaning": "钢管毛截面面积（按实际壁厚检查结果计算；48.3×3.6→506mm²）", "unit": "mm²", "source": "T-JGJ130-section-props"},
        "f": {"meaning": "钢材抗压强度设计值（Q235≤16mm: 215）", "unit": "N/mm²", "source": "T-JGJ162-steel-design"}
      },
      "applies_to": "M-6 模板支架立杆稳定·不组合风（JGJ 162-2008）",
