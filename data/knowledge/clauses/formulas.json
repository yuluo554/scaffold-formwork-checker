    },
    {
      "formula_id": "F-J130-tie-N",
      "expr": "Nl = Nlw + N0",
      "params": {
        "Nlw": {"meaning": "风荷载产生连墙件轴向力设计值", "unit": "kN", "source": "F-J130-tie-Nlw"},
