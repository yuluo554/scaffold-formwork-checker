    },
    {
      "formula_id": "F-J162-Mw",
      "expr": "Mw = 0.9^2 * 1.4 * wk * la * h^2 / 10",
      "params": {
        "wk": {"meaning": "风荷载标准值（βz=1，n=10 年）", "unit": "kN/m²", "source": "JGJ162-4.1.3"},
        "la": {"meaning": "立柱迎风面的间距", "unit": "m", "source": "输入参数"},
        "h": {"meaning": "纵横水平拉杆的计算步距（≤1.8m）", "unit": "m", "source": "T-JGJ162-column-step"}
      },
      "applies_to": "M-6 模板支架立杆稳定·组合风",
      "clause_refs": ["JGJ162-5.2.5"],
      "status": "已核对",
