        "Aw": {"meaning": "单个连墙件覆盖的脚手架外侧面迎风面积（表6.4.2：3h×3la，≤40/27m²）", "unit": "m²", "source": "T-JGJ130-walltie-spacing"}
      },
      "applies_to": "M-4 连墙件",
      "clause_refs": ["JGJ130-5.2.13", "JGJ130-6.4.2"],
      "status": "已核对",
      "source": {"file": "JGJ130-2011_pmgd_imgs/1-2309161F934401.jpg", "fetched": "2026-10-06"}
    },
    {
      "formula_id": "F-J130-foundation",
      "expr": "pk = Nk / A <= fg",
      "params": {
        "Nk": {"meaning": "上部结构传至立杆基础顶面的轴向力标准值", "unit": "kN", "source": "输入/由标准组合计算"},
        "A": {"meaning": "基础底面面积（垫板/底座尺寸）", "unit": "m²", "source": "输入参数"},
        "fg": {"meaning": "地基承载力特征值（天然地基按勘察报告；回填土×0.4）", "unit": "kPa", "source": "T-JGJ130-fg-reduction"}
      },
      "applies_to": "M-5 立杆地基承载力",
